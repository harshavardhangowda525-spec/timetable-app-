# INFINITY OS runs on Floot. Floot provisions and injects these at runtime.
# Never commit real values. None of these are ever sent to the browser.

# Postgres connection string (Floot-managed database)
FLOOT_DATABASE_URL=

# Secret used to sign the session cookie (Floot auth)
JWT_SECRET=

# Optional: sender address for password-reset emails (needs a verified domain in Floot)
RESET_EMAIL_FROM=

# AI: xAI Grok (server-side only). Create a key at console.x.ai
XAI_API_KEY=
# Optional: pin a model, e.g. grok-4.6 (default: first available of grok-4.6, grok-4.5, grok-4, grok-3)
XAI_MODEL=
